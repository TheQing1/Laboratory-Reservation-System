# ===================== 智能实验室预约系统 配置 =====================
# 复制本文件为 .env 后按需修改。环境变量优先级高于本文件。

# ---- 基础 ----
APP_NAME=智能实验室预约系统
DEBUG=true
SECRET_KEY=please-change-this-to-a-random-secret-string

# ---- 数据库（默认 SQLite；MySQL 示例：mysql+pymysql://root:123456@127.0.0.1:3306/lab_booking?charset=utf8mb4）----
# DATABASE_URL=sqlite:///./data/lab_booking.db

# ---- JWT 有效期（分钟）----
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 跨域（多个用英文逗号分隔；开发期可用 *）----
CORS_ORIGINS=*

# ---- 文件上传 ----
# UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# ===================== 大模型配置（OpenAI 兼容协议）=====================
# 不填 LLM_API_KEY 时，系统自动使用「本地助手模式」：
# 依然支持工具调用、知识库检索、流式输出，只是由内置意图引擎驱动。
LLM_API_KEY=
# DeepSeek:      https://api.deepseek.com/v1       模型 deepseek-chat
# 通义千问:       https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
# 智谱 GLM:      https://open.bigmodel.cn/api/paas/v4  模型 glm-4-flash
# 月之暗面:       https://api.moonshot.cn/v1        模型 moonshot-v1-8k
# 本地 Ollama:    http://localhost:11434/v1         模型 qwen2.5:7b
# OpenAI:        https://api.openai.com/v1          模型 gpt-4o-mini
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=60

# ===================== 向量模型（可选）=====================
# 留空则使用内置的确定性向量（离线可用，无需下载模型）
# 填写后优先调用远端 embeddings 接口，检索更精准
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=3
LOCAL_EMBED_DIM=512
